FB_CRAWL_HEADLESS=false
FB_CRAWL_PROXY=
FB_CRAWL_SESSION_PATH=runtime/session.json
FB_CRAWL_BROWSER_TIMEOUT_SECONDS=30
FB_CRAWL_VERIFICATION_TIMEOUT_SECONDS=300

FB_CRAWL_API_KEY=replace-with-at-least-32-random-characters
FB_CRAWL_API_CORS_ORIGINS=
FB_CRAWL_API_DOCS=false

# Required when running the production Lead Finder product API.
# Generate independent random secrets of at least 32 characters; do not commit values.
LEAD_FINDER_JWT_SECRET=
LEAD_FINDER_TOKEN_HMAC_SECRET=
LEAD_FINDER_PUBLIC_BASE_URL=https://leads.example.com
LEAD_FINDER_TIMEZONE=Asia/Ho_Chi_Minh
LEAD_FINDER_ENV=production
LEAD_FINDER_ACCOUNT_RECOVERY_DAYS=30

LEAD_FINDER_SMTP_HOST=localhost
LEAD_FINDER_SMTP_PORT=587
LEAD_FINDER_SMTP_USERNAME=
LEAD_FINDER_SMTP_PASSWORD=
LEAD_FINDER_SMTP_SENDER=Lead Finder <noreply@example.com>

FB_NUMBER_API_URL=https://api.fbnumber.com/v1/phone/search
FB_NUMBER_API_TOKEN=
FB_NUMBER_AUTH_HEADER=Authorization
FB_NUMBER_AUTH_SCHEME=Bearer
FB_NUMBER_TIMEOUT_SECONDS=15
FB_NUMBER_MAX_RETRIES=2
PIPELINE_DEFAULT_COUNTRY_CODE=84

DATABASE_URL=postgresql://fb_pipeline:fb_pipeline_dev@localhost:5432/fb_pipeline
DATABASE_STATEMENT_TIMEOUT_SECONDS=5
POSTGRES_DB=fb_pipeline
POSTGRES_USER=fb_pipeline
POSTGRES_PASSWORD=fb_pipeline_dev
POSTGRES_PORT=5432
